{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VES Studio Source Frontmatter v1",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "owner",
    "authored_by",
    "review_status",
    "updated",
    "source_type",
    "scope",
    "canonical",
    "dependencies"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "PARTIAL",
        "SUPERSEDED",
        "ARCHIVED",
        "BLOCKED",
        "ARCHITECTURE_ONLY"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "authored_by": {
      "enum": ["Claude Code", "Ves", "Piotrek"]
    },
    "review_status": {
      "enum": ["UNREVIEWED", "REVIEWED", "APPROVED"]
    },
    "reviewed_by": {
      "type": ["string", "null"]
    },
    "approved_by": {
      "type": ["string", "null"]
    },
    "approval_date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "record_created": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "decision_date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "approval_evidence": {
      "type": ["string", "null"]
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source_type": {
      "enum": [
        "normative",
        "state",
        "decision",
        "evidence",
        "template",
        "registry",
        "generated-runtime"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "canonical": {
      "type": "boolean"
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_status": {
      "enum": ["PROPOSED", "ACCEPTED", "SUPERSEDED", "REJECTED"]
    },
    "external_sync_status": {
      "enum": ["NOT_REQUIRED", "PENDING", "SYNCED"]
    },
    "approval_scope": {
      "enum": ["content", "hypothesis", "provisional", "architecture", "decision"]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
