{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VES Studio Source Registry v1",
  "type": "object",
  "required": [
    "version",
    "updated",
    "sources"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "domain",
          "owner",
          "status",
          "criticality",
          "availability_state",
          "freshness_state",
          "integrity_state"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "DRAFT",
              "SUPERSEDED",
              "MISSING",
              "EXTERNAL"
            ]
          },
          "criticality": {
            "enum": ["low", "medium", "high", "critical"]
          },
          "availability_state": {
            "enum": ["AVAILABLE", "BLOCKED", "MISSING"]
          },
          "freshness_state": {
            "enum": ["CURRENT", "STALE", "UNKNOWN"]
          },
          "integrity_state": {
            "enum": ["CONSISTENT", "CONFLICTED"]
          },
          "uri": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_verified": {
            "type": [
              "string",
              "null"
            ]
          },
          "refresh_policy": {
            "type": "string"
          },
          "write_access": {
            "type": "string"
          },
          "known_conflicts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["summary", "severity"],
              "properties": {
                "summary": {"type": "string"},
                "severity": {"enum": ["INFO", "WARNING", "BLOCKING"]},
                "blocks_workflow": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
